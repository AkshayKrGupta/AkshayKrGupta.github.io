---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/common/Badge.astro';
import ArticleCard from '../../components/blog/ArticleCard.astro';
import { site } from '../../data/site';
import { getPublishedPosts, getAllUniqueTags, routes } from '../../utils/blog';

const sortedPosts = await getPublishedPosts();
const allTags = await getAllUniqueTags();
---

<BaseLayout
  title={site.blog.name}
  description={site.blog.description}
  image="/og-articles-image.png"
>
  <div class="page-container blog-index-container">
    <div class="blog-grid">
      <!-- Main Content Column (~75% on Desktop, 100% on Mobile) -->
      <main class="blog-main-column">
        <header class="blog-index-header">
          <div class="kicker-row">
            <p class="swiss-kicker">Publications &amp; Articles</p>
            <span class="meta-dot font-mono" aria-hidden="true">&bull;</span>
            <span class="notes-count font-mono">{sortedPosts.length} {sortedPosts.length === 1 ? 'note' : 'notes'}</span>
          </div>
          <h1 class="swiss-heading-1">{site.blog.name}</h1>
          <p class="text-muted blog-desc">{site.blog.description}</p>
        </header>

        <div class="articles-archive">
          {sortedPosts.length === 0 ? (
            <div class="empty-state">
              <p class="text-muted">No architecture notes published yet. Check back soon!</p>
            </div>
          ) : (
            sortedPosts.map((post) => (
              <ArticleCard post={post} variant="standard" />
            ))
          )}
        </div>
      </main>

      <!-- Sticky Topics Sidebar (~25% Desktop Only, Hidden on Mobile) -->
      {allTags.length > 0 && (
        <aside class="topics-sidebar" aria-label="Topic Filter Sidebar">
          <div class="topics-card">
            <div class="topics-card-header">
              <span class="swiss-kicker">Explore Topics</span>
            </div>
            <div class="topics-list">
              <a href={routes.blog} class="topic-item">
                <Badge variant="accent" size="sm">All Notes ({sortedPosts.length})</Badge>
              </a>
              {allTags.map((tag) => {
                const count = sortedPosts.filter((p) => p.data.tags.includes(tag)).length;
                return (
                  <a href={routes.tag(tag)} class="topic-item">
                    <Badge variant="neutral" size="sm">#{tag} ({count})</Badge>
                  </a>
                );
              })}
            </div>
          </div>
        </aside>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .blog-index-container {
    padding-top: var(--space-7);
    padding-bottom: var(--space-10);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 1024px) {
    .blog-grid {
      grid-template-columns: minmax(0, 760px) 260px;
      justify-content: center;
    }
  }

  .blog-main-column {
    min-width: 0;
    width: 100%;
  }

  .blog-index-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .kicker-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .kicker-row .swiss-kicker {
    margin-bottom: 0;
  }

  .meta-dot {
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
  }

  .notes-count {
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .blog-desc {
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }

  .articles-archive {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .empty-state {
    padding: var(--space-8);
    text-align: center;
    background-color: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
  }

  /* Sticky Topics Sidebar (Desktop Only) */
  .topics-sidebar {
    display: none;
  }

  @media (min-width: 1024px) {
    .topics-sidebar {
      display: block;
    }

    .topics-card {
      position: sticky;
      top: calc(var(--header-height, 64px) + var(--space-6));
      padding: var(--space-5);
      background-color: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-neu-sm);
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }

    .topics-card-header {
      padding-bottom: var(--space-2);
      border-bottom: 1px solid var(--color-border-subtle);
    }

    .topics-card-header .swiss-kicker {
      margin-bottom: 0;
    }

    .topics-list {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }

    .topic-item {
      text-decoration: none;
      transition: transform var(--transition-fast);
    }

    .topic-item:hover {
      transform: translateY(-1px);
    }
  }
</style>
