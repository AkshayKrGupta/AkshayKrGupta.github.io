---
import BaseLayout from '../layouts/BaseLayout.astro';
import BentoCard from '../components/bento/BentoCard.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Page Not Found (404)"
  description="The requested page could not be found."
>
  <div class="page-container not-found-container">
    <BentoCard variant="raised" colSpan="12" class="not-found-card">
      <p class="swiss-kicker">Error 404</p>
      <h1 class="swiss-heading-display">Page Not Found</h1>
      <p class="text-muted not-found-desc">
        The page you are looking for might have been moved, renamed, or does not exist in this realm.
      </p>

      <div class="actions-row">
        <a href="/" class="neu-button neu-button-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          <span>Return Home</span>
        </a>
        <a href="/blog/" class="neu-button neu-button-secondary">
          <span>Browse Architecture Notes</span>
        </a>
      </div>
    </BentoCard>
  </div>
</BaseLayout>

<style>
  .not-found-container {
    padding-top: var(--space-9);
    padding-bottom: var(--space-10);
    max-width: 680px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .not-found-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-8);
  }

  .not-found-desc {
    font-size: var(--text-base);
    line-height: var(--leading-normal);
  }

  .actions-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
</style>
