---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import PostHeader from '../components/blog/PostHeader.astro';
import PostFooter from '../components/blog/PostFooter.astro';
import TableOfContents from '../components/blog/TableOfContents.astro';
import RelatedPosts from '../components/blog/RelatedPosts.astro';
import ArchitectureBackground from '../components/blog/ArchitectureBackground.astro';
import ImageLightbox from '../components/blog/ImageLightbox.astro';
import CodeBlockEnhancer from '../components/blog/CodeBlockEnhancer.astro';
import { getReadingTime, getWordCount } from '../utils/readingTime';
import type { BlogPost } from '../utils/blog';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  tags: string[];
  keywords?: string[];
  heroImage?: string | ImageMetadata;
  headings: Heading[];
  prevPost?: BlogPost;
  nextPost?: BlogPost;
  relatedPosts?: BlogPost[];
  rawContent?: string;
  faqs?: FAQItem[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  author,
  tags,
  keywords = [],
  heroImage,
  headings,
  prevPost,
  nextPost,
  relatedPosts = [],
  rawContent = '',
  faqs = [],
} = Astro.props;

const readingTime = getReadingTime(rawContent);
const wordCount = getWordCount(rawContent);

// Generate lightweight, optimized social preview card (<350KB) to prevent social crawler timeouts
let socialImage = '/og-articles-image.png';
if (typeof heroImage === 'object' && heroImage !== null && 'src' in heroImage) {
  try {
    const ogOptimized = await getImage({
      src: heroImage as ImageMetadata,
      width: 1200,
      height: 630,
      format: 'png',
      quality: 85,
    });
    socialImage = ogOptimized.src;
  } catch (err) {
    socialImage = (heroImage as ImageMetadata).src;
  }
} else if (typeof heroImage === 'string') {
  socialImage = heroImage;
}
---

<BaseLayout
  title={title}
  description={description}
  image={socialImage}
  article={true}
  publishDate={pubDate}
  modifiedDate={updatedDate}
  tags={tags}
  keywords={keywords}
  faqs={faqs}
  wordCount={wordCount}
  readingTime={readingTime}
>
  <!-- Architectural Visual Signature Background (Zero JS, GPU Layer) -->
  <ArchitectureBackground />

  <!-- Reading Progress Bar (Hardware Accelerated, <0.2 kB JS) -->
  <div id="reading-progress" class="reading-progress-bar" aria-hidden="true"></div>

  <div class="page-container blog-layout-container">
    <div class="blog-grid">
      <!-- Main Editorial Content Column -->
      <article class="article-column">
        <PostHeader
          title={title}
          description={description}
          pubDate={pubDate}
          updatedDate={updatedDate}
          author={author}
          tags={tags}
          readingTime={readingTime}
          heroImage={heroImage}
        />

        <div class="prose-content">
          <slot />
        </div>

        <PostFooter prevPost={prevPost} nextPost={nextPost} tags={tags} />

        {relatedPosts.length > 0 && (
          <RelatedPosts posts={relatedPosts} />
        )}
      </article>

      <!-- Sticky TOC Sidebar (Desktop) -->
      <aside class="toc-sidebar">
        <TableOfContents headings={headings} />
      </aside>
    </div>
  </div>

  <!-- Interactive Architecture Diagram & Image Zoom Lightbox -->
  <ImageLightbox />

  <!-- Developer-Grade Code Block Terminal Chrome & Dual Theme Enhancer -->
  <CodeBlockEnhancer />
</BaseLayout>

<style>
  /* Reading Progress Bar */
  .reading-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    width: 0%;
    height: 3px;
    background-color: var(--color-accent);
    z-index: 1000;
    transition: width 50ms ease-out;
    box-shadow: 0 0 8px var(--color-accent);
  }

  .blog-layout-container {
    position: relative;
    z-index: 1;
    padding-top: var(--space-7);
    padding-bottom: var(--space-9);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 1024px) {
    .blog-grid {
      grid-template-columns: minmax(0, 760px) 260px;
      justify-content: center;
    }
  }

  .article-column {
    min-width: 0;
    width: 100%;
  }

  .toc-sidebar {
    display: none;
  }

  @media (min-width: 1024px) {
    .toc-sidebar {
      display: block;
    }
  }

  /* ==========================================================================
     Prose Content Styling (Swiss Editorial)
     ========================================================================== */
  .prose-content {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }

  .prose-content :global(h2),
  .prose-content :global(h3) {
    position: relative;
  }

  .prose-content :global(h2) {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.025em;
    margin-top: var(--space-7);
    margin-bottom: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-subtle);
    color: var(--color-text);
    scroll-margin-top: 100px;
  }

  .prose-content :global(h3) {
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
    color: var(--color-text);
    scroll-margin-top: 100px;
  }

  .prose-content :global(.heading-anchor) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-left: 8px;
    font-size: 0.75em;
    color: var(--color-text-subtle);
    opacity: 0;
    text-decoration: none;
    transition: opacity var(--transition-fast), color var(--transition-fast);
    vertical-align: middle;
  }

  .prose-content :global(h2:hover .heading-anchor),
  .prose-content :global(h3:hover .heading-anchor) {
    opacity: 1;
  }

  .prose-content :global(.heading-anchor:hover) {
    color: var(--color-accent);
  }

  .prose-content :global(h4) {
    font-size: var(--text-lg);
    font-weight: 600;
    margin-top: var(--space-5);
    margin-bottom: var(--space-2);
    color: var(--color-text);
  }

  .prose-content :global(p) {
    margin-bottom: var(--space-4);
    max-width: 680px;
  }

  .prose-content :global(ul),
  .prose-content :global(ol) {
    margin-bottom: var(--space-4);
    padding-left: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 680px;
  }

  .prose-content :global(li) {
    line-height: var(--leading-normal);
  }

  .prose-content :global(blockquote) {
    margin: var(--space-6) 0;
    padding: var(--space-4) var(--space-5);
    border-left: 4px solid var(--color-accent);
    background-color: var(--color-surface);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-style: italic;
    color: var(--color-text-muted);
  }

  .prose-content :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .prose-content :global(hr) {
    margin: var(--space-7) 0;
    border: none;
    border-top: 1px solid var(--color-border);
  }

  .prose-content :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose-content :global(a:hover) {
    color: var(--color-accent-hover);
  }

  /* Inline Code */
  .prose-content :global(:not(pre) > code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    padding: 2px 6px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    color: var(--color-accent);
  }

  /* Tables */
  .prose-content :global(table) {
    width: 100%;
    margin: var(--space-6) 0;
    border-collapse: collapse;
    font-size: var(--text-sm);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: block;
    overflow-x: auto;
  }

  .prose-content :global(th),
  .prose-content :global(td) {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    text-align: left;
  }

  .prose-content :global(th) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background-color: var(--color-surface-raised);
    color: var(--color-text);
  }

  .prose-content :global(tr:last-child td) {
    border-bottom: none;
  }
</style>

<!-- Client Scripts: Progress Bar, Code Copy & Heading Anchors (<0.4 kB Total) -->
<script is:inline>
  // 1. Reading Progress Bar
  function initProgressBar() {
    const bar = document.getElementById('reading-progress');
    if (!bar) return;

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
          if (totalHeight > 0) {
            const progress = (window.scrollY / totalHeight) * 100;
            bar.style.width = Math.min(100, Math.max(0, progress)) + '%';
          }
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  }

  // 2. Heading Anchor Links
  function initHeadingAnchors() {
    const headings = document.querySelectorAll('.prose-content h2, .prose-content h3');
    headings.forEach((heading) => {
      if (heading.querySelector('.heading-anchor')) return;
      if (!heading.id) {
        heading.id = heading.textContent.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
      }

      const anchor = document.createElement('a');
      anchor.className = 'heading-anchor font-mono';
      anchor.href = '#' + heading.id;
      anchor.setAttribute('aria-label', `Link to ${heading.textContent}`);
      anchor.textContent = '#';
      heading.appendChild(anchor);
    });
  }

  function initAll() {
    initProgressBar();
    initHeadingAnchors();
  }

  initAll();
  document.addEventListener('astro:after-swap', initAll);
</script>
