---
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import PostHeader from '../components/blog/PostHeader.astro';
import PostFooter from '../components/blog/PostFooter.astro';
import TableOfContents from '../components/blog/TableOfContents.astro';
import RelatedPosts from '../components/blog/RelatedPosts.astro';
import ArchitectureBackground from '../components/blog/ArchitectureBackground.astro';
import { getReadingTime } from '../utils/readingTime';
import type { BlogPost } from '../utils/blog';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  tags: string[];
  heroImage?: string | ImageMetadata;
  headings: Heading[];
  prevPost?: BlogPost;
  nextPost?: BlogPost;
  relatedPosts?: BlogPost[];
  rawContent?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  author,
  tags,
  heroImage,
  headings,
  prevPost,
  nextPost,
  relatedPosts = [],
  rawContent = '',
} = Astro.props;

const readingTime = getReadingTime(rawContent);
const socialImage = typeof heroImage === 'object' && heroImage !== null ? (heroImage as ImageMetadata).src : (heroImage || '/og-articles-image.png');
---

<BaseLayout
  title={title}
  description={description}
  image={socialImage}
  article={true}
  publishDate={pubDate}
  modifiedDate={updatedDate}
  tags={tags}
>
  <!-- Architectural Visual Signature Background (Zero JS, GPU Layer) -->
  <ArchitectureBackground />

  <!-- Reading Progress Bar (Hardware Accelerated, <0.2 kB JS) -->
  <div id="reading-progress" class="reading-progress-bar" aria-hidden="true"></div>

  <div class="page-container blog-layout-container">
    <div class="blog-grid">
      <!-- Main Editorial Content Column -->
      <article class="article-column">
        <PostHeader
          title={title}
          description={description}
          pubDate={pubDate}
          updatedDate={updatedDate}
          author={author}
          tags={tags}
          readingTime={readingTime}
          heroImage={heroImage}
        />

        <div class="prose-content">
          <slot />
        </div>

        <PostFooter prevPost={prevPost} nextPost={nextPost} tags={tags} />

        {relatedPosts.length > 0 && (
          <RelatedPosts posts={relatedPosts} />
        )}
      </article>

      <!-- Sticky TOC Sidebar (Desktop) -->
      <aside class="toc-sidebar">
        <TableOfContents headings={headings} />
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  /* Reading Progress Bar */
  .reading-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    width: 0%;
    height: 3px;
    background-color: var(--color-accent);
    z-index: 1000;
    transition: width 50ms ease-out;
    box-shadow: 0 0 8px var(--color-accent);
  }

  .blog-layout-container {
    position: relative;
    z-index: 1;
    padding-top: var(--space-7);
    padding-bottom: var(--space-9);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 1024px) {
    .blog-grid {
      grid-template-columns: minmax(0, 760px) 260px;
      justify-content: center;
    }
  }

  .article-column {
    min-width: 0;
    width: 100%;
  }

  .toc-sidebar {
    display: none;
  }

  @media (min-width: 1024px) {
    .toc-sidebar {
      display: block;
    }
  }

  /* ==========================================================================
     Prose Content Styling (Swiss Editorial)
     ========================================================================== */
  .prose-content {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }

  .prose-content :global(h2),
  .prose-content :global(h3) {
    position: relative;
  }

  .prose-content :global(h2) {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.025em;
    margin-top: var(--space-7);
    margin-bottom: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-subtle);
    color: var(--color-text);
    scroll-margin-top: 100px;
  }

  .prose-content :global(h3) {
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
    color: var(--color-text);
    scroll-margin-top: 100px;
  }

  .prose-content :global(.heading-anchor) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-left: 8px;
    font-size: 0.75em;
    color: var(--color-text-subtle);
    opacity: 0;
    text-decoration: none;
    transition: opacity var(--transition-fast), color var(--transition-fast);
    vertical-align: middle;
  }

  .prose-content :global(h2:hover .heading-anchor),
  .prose-content :global(h3:hover .heading-anchor) {
    opacity: 1;
  }

  .prose-content :global(.heading-anchor:hover) {
    color: var(--color-accent);
  }

  .prose-content :global(h4) {
    font-size: var(--text-lg);
    font-weight: 600;
    margin-top: var(--space-5);
    margin-bottom: var(--space-2);
    color: var(--color-text);
  }

  .prose-content :global(p) {
    margin-bottom: var(--space-4);
  }

  .prose-content :global(ul),
  .prose-content :global(ol) {
    margin-bottom: var(--space-4);
    padding-left: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .prose-content :global(li) {
    line-height: var(--leading-normal);
  }

  .prose-content :global(blockquote) {
    margin: var(--space-6) 0;
    padding: var(--space-4) var(--space-5);
    border-left: 4px solid var(--color-accent);
    background-color: var(--color-surface);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-style: italic;
    color: var(--color-text-muted);
  }

  .prose-content :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .prose-content :global(hr) {
    margin: var(--space-7) 0;
    border: none;
    border-top: 1px solid var(--color-border);
  }

  .prose-content :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose-content :global(a:hover) {
    color: var(--color-accent-hover);
  }

  /* Inline Code */
  .prose-content :global(:not(pre) > code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    padding: 2px 6px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    color: var(--color-accent);
  }

  /* Code Blocks */
  .prose-content :global(pre) {
    position: relative;
    margin: var(--space-6) 0;
    padding: var(--space-6) var(--space-5) var(--space-5);
    border-radius: var(--radius-md);
    background-color: #161b22 !important;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-raised);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .prose-content :global(pre .code-lang-tag) {
    position: absolute;
    top: 8px;
    left: 12px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8b949e;
    user-select: none;
  }

  .prose-content :global(pre code) {
    font-family: inherit;
    font-size: inherit;
    color: inherit;
    background: transparent;
    border: none;
    padding: 0;
  }

  /* Tables */
  .prose-content :global(table) {
    width: 100%;
    margin: var(--space-6) 0;
    border-collapse: collapse;
    font-size: var(--text-sm);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: block;
    overflow-x: auto;
  }

  .prose-content :global(th),
  .prose-content :global(td) {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    text-align: left;
  }

  .prose-content :global(th) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background-color: var(--color-surface-raised);
    color: var(--color-text);
  }

  .prose-content :global(tr:last-child td) {
    border-bottom: none;
  }
</style>

<!-- Client Scripts: Progress Bar, Code Copy & Heading Anchors (<0.4 kB Total) -->
<script is:inline>
  // 1. Reading Progress Bar
  function initProgressBar() {
    const bar = document.getElementById('reading-progress');
    if (!bar) return;

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
          if (totalHeight > 0) {
            const progress = (window.scrollY / totalHeight) * 100;
            bar.style.width = Math.min(100, Math.max(0, progress)) + '%';
          }
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  }

  // 2. Heading Anchor Links
  function initHeadingAnchors() {
    const headings = document.querySelectorAll('.prose-content h2, .prose-content h3');
    headings.forEach((heading) => {
      if (heading.querySelector('.heading-anchor')) return;
      if (!heading.id) {
        heading.id = heading.textContent.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
      }

      const anchor = document.createElement('a');
      anchor.className = 'heading-anchor font-mono';
      anchor.href = '#' + heading.id;
      anchor.setAttribute('aria-label', `Link to ${heading.textContent}`);
      anchor.textContent = '#';
      heading.appendChild(anchor);
    });
  }

  // 3. Code Block Copy & Language Tags
  function initCodeEnhancements() {
    const preBlocks = document.querySelectorAll('.prose-content pre');
    
    preBlocks.forEach((pre) => {
      // Language Tag
      if (!pre.querySelector('.code-lang-tag')) {
        const langMatch = pre.className.match(/language-([a-zA-Z0-9_-]+)/) || pre.querySelector('code')?.className.match(/language-([a-zA-Z0-9_-]+)/);
        const lang = langMatch ? langMatch[1] : 'CODE';
        const langTag = document.createElement('span');
        langTag.className = 'code-lang-tag';
        langTag.textContent = lang.toUpperCase();
        pre.appendChild(langTag);
      }

      // Copy Button
      if (pre.querySelector('.copy-code-btn')) return;

      const button = document.createElement('button');
      button.className = 'copy-code-btn neu-control';
      button.setAttribute('type', 'button');
      button.setAttribute('aria-label', 'Copy code to clipboard');
      button.innerHTML = `
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
          <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
        </svg>
      `;

      button.style.position = 'absolute';
      button.style.top = '6px';
      button.style.right = '8px';
      button.style.width = '28px';
      button.style.height = '28px';
      button.style.padding = '0';
      button.style.backgroundColor = 'rgba(255, 255, 255, 0.08)';
      button.style.borderColor = 'rgba(255, 255, 255, 0.15)';
      button.style.color = '#e6edf3';

      button.addEventListener('click', async () => {
        const code = pre.querySelector('code')?.innerText || pre.innerText;
        try {
          await navigator.clipboard.writeText(code);
          button.innerHTML = `
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#34c759" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          `;
          setTimeout(() => {
            button.innerHTML = `
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
                <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
              </svg>
            `;
          }, 2000);
        } catch (err) {
          console.warn('Failed to copy code: ', err);
        }
      });

      pre.appendChild(button);
    });
  }

  function initAll() {
    initProgressBar();
    initHeadingAnchors();
    initCodeEnhancements();
  }

  initAll();
  document.addEventListener('astro:after-swap', initAll);
</script>
