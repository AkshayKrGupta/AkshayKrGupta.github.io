---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  faqs: FAQItem[];
}

const { faqs = [] } = Astro.props;
---

{faqs.length > 0 && (
  <section class="post-faq-section" id="key-architectural-notes" aria-labelledby="faq-title">
    <div class="faq-header">
      <div class="faq-kicker-row">
        <h2 id="faq-title" class="swiss-kicker">Key Architectural Notes</h2>
        <span class="faq-count-pill font-mono">{faqs.length} Notes</span>
      </div>
    </div>

    <div class="faq-list">
      {faqs.map((faq, index) => (
        <details class="faq-card" open={index === 0}>
          <summary class="faq-question">
            <span class="faq-question-text">{faq.question}</span>
            <span class="faq-toggle-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </summary>
          <div class="faq-answer-content">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </section>
)}

<style>
  .post-faq-section {
    margin-top: var(--space-8);
    padding-top: var(--space-7);
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 100px;
  }

  .faq-header {
    margin-bottom: var(--space-4);
  }

  .faq-kicker-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .faq-kicker-row h2.swiss-kicker {
    margin: 0;
  }

  .faq-count-pill {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-text-subtle);
    background-color: var(--color-surface-sunken);
    padding: 2px 8px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-subtle);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .faq-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-neu-sm);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
    overflow: hidden;
  }

  .faq-card:hover {
    border-color: var(--color-accent);
  }

  .faq-card[open] {
    border-left: 3px solid var(--color-accent);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    cursor: pointer;
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text);
    list-style: none;
    user-select: none;
    transition: color var(--transition-fast);
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question:hover {
    color: var(--color-accent);
  }

  .faq-question:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  .faq-question-text {
    flex: 1;
    line-height: var(--leading-snug);
  }

  .faq-toggle-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-xs);
    background-color: var(--color-surface-sunken);
    color: var(--color-text-muted);
    transition: transform var(--transition-smooth), color var(--transition-fast), background-color var(--transition-fast);
  }

  .faq-card[open] .faq-toggle-icon {
    transform: rotate(180deg);
    color: var(--color-accent);
    background-color: var(--color-accent-subtle);
  }

  .faq-answer-content {
    padding: 0 var(--space-5) var(--space-5) var(--space-5);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    border-top: 1px solid var(--color-border-subtle);
    padding-top: var(--space-4);
  }

  .faq-answer-content p {
    margin: 0;
  }

  @media (max-width: 640px) {
    .faq-question {
      padding: var(--space-3) var(--space-4);
      font-size: var(--text-sm);
    }

    .faq-answer-content {
      padding: var(--space-3) var(--space-4) var(--space-4) var(--space-4);
      font-size: var(--text-sm);
    }
  }
</style>
