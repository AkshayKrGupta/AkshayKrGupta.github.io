---
import type { BlogPost } from '../../utils/blog';
import { routes } from '../../utils/blog';
import { formatDate } from '../../utils/formatters';
import { getReadingTime } from '../../utils/readingTime';
import Badge from '../common/Badge.astro';

interface Props {
  post: BlogPost;
  variant?: 'standard' | 'compact';
  headingTag?: 'h2' | 'h3' | 'h4';
  class?: string;
}

const {
  post,
  variant = 'standard',
  headingTag = variant === 'standard' ? 'h2' : 'h4',
  class: className = '',
} = Astro.props;

const readingTime = getReadingTime(post.body || '');
const postUrl = routes.post(post.slug);
const HeadingComponent = headingTag;
---

<article class={`article-card card-${variant} ${className}`}>
  <div class="card-meta font-mono">
    <time datetime={post.data.pubDate.toISOString()}>
      {formatDate(post.data.pubDate)}
    </time>
    <span class="meta-dot" aria-hidden="true">&bull;</span>
    <span class="reading-time">{readingTime}</span>
    {post.data.draft && (
      <Badge variant="outline" size="sm">Draft</Badge>
    )}
  </div>

  <HeadingComponent class={`card-title ${variant === 'standard' ? 'swiss-heading-3' : 'swiss-heading-4'}`}>
    <a href={postUrl} class="card-link">
      <span>{post.data.title}</span><span class="title-arrow" aria-hidden="true">&nbsp;&rarr;</span>
    </a>
  </HeadingComponent>

  <p class="card-desc text-muted">{post.data.description}</p>

  {post.data.tags.length > 0 && (
    <div class="card-tags">
      {variant === 'standard'
        ? post.data.tags.map((tag) => (
            <Badge variant="neutral" size="sm">#{tag}</Badge>
          ))
        : post.data.tags.slice(0, 3).map((tag) => (
            <Badge variant="neutral" size="sm">#{tag}</Badge>
          ))}
    </div>
  )}
</article>

<style>
  .article-card {
    position: relative;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-border);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    cursor: pointer;
    transition: transform var(--transition-fast), border-left-color var(--transition-fast), box-shadow var(--transition-fast), background-color var(--transition-fast);
  }

  /* Desktop Hover Interactions */
  @media (hover: hover) and (pointer: fine) {
    .article-card:hover {
      transform: translateY(-2px);
      border-left-color: var(--color-accent);
      box-shadow: var(--shadow-raised);
    }

    .article-card:hover .card-title a {
      color: var(--color-accent);
    }

    .article-card:hover .title-arrow {
      opacity: 1;
      transform: translateX(3px);
      color: var(--color-accent);
    }
  }

  /* Tactile Feedback for Tap / Press */
  .article-card:active {
    transform: translateY(0) scale(0.995);
    background-color: var(--color-surface-raised);
  }

  /* Keyboard Focus Styling */
  .article-card:focus-within {
    border-left-color: var(--color-accent);
    box-shadow: var(--shadow-raised);
  }

  .card-title a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: var(--radius-xs);
  }

  /* Stretched Link: Makes entire card clickable */
  .card-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-md);
    z-index: 1;
  }

  /* Standard Variant (Blog Archive & Tag pages) */
  .card-standard {
    padding: var(--space-6);
    gap: var(--space-3);
  }

  .card-standard .card-title {
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: var(--leading-snug);
    letter-spacing: -0.02em;
  }

  .card-standard .card-desc {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  /* Compact Variant (Bento Grid & Related Posts) */
  .card-compact {
    padding: var(--space-5);
    gap: var(--space-2);
  }

  .card-compact .card-title {
    font-size: var(--text-base);
    font-weight: 700;
    line-height: var(--leading-snug);
  }

  .card-compact .card-desc {
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
  }

  /* Shared Card Elements */
  .card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  .card-title a {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-fast);
    display: inline;
  }

  /* Animated Arrow with Orphan Prevention */
  .title-arrow {
    display: inline-block;
    white-space: nowrap;
    font-family: var(--font-sans);
    font-weight: 400;
    opacity: 0;
    transform: translateX(-4px);
    transition: transform var(--transition-fast), opacity var(--transition-fast), color var(--transition-fast);
  }

  /* Tags hidden on mobile (< 640px) to maximize screen real estate */
  .card-tags {
    display: none;
  }

  @media (min-width: 640px) {
    .card-tags {
      position: relative;
      z-index: 2;
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: var(--space-1);
      pointer-events: none;
    }
  }

  /* Accessibility: Prefers Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .article-card,
    .title-arrow {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
