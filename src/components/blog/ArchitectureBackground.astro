---
// ArchitectureBackground.astro
// Pure static SVG architectural signature (Zero JavaScript runtime overhead)
// Positioned exclusively in the outer viewport gutters to keep reading text 100% clean
---

<div class="arch-bg-fixed" aria-hidden="true">
  <!-- Left Peripheral Wing (Outer Left Gutter) -->
  <svg class="arch-wing arch-wing-left" viewBox="0 0 200 480" fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- Registration Crosshair -->
    <path d="M40,50 L40,62 M34,56 L46,56" stroke="currentColor" stroke-width="1" />

    <!-- Vertical Data Bus & Interconnects -->
    <line x1="40" y1="90" x2="40" y2="240" stroke="currentColor" stroke-width="1.2" />
    <polyline points="40,150 110,180 160,140" stroke="currentColor" stroke-width="1.2" stroke-dasharray="4 4" />
    <line x1="110" y1="180" x2="110" y2="300" stroke="currentColor" stroke-width="1.2" />
    <polyline points="40,240 90,290 140,290" stroke="currentColor" stroke-width="1.2" />
    <line x1="110" y1="300" x2="60" y2="380" stroke="currentColor" stroke-width="1.2" stroke-dasharray="3 3" />
    <path d="M60,380 L60,430 L110,430" stroke="currentColor" stroke-width="1.2" />

    <!-- Nodes -->
    <circle cx="40" cy="90" r="3.5" fill="currentColor" />
    <circle cx="40" cy="150" r="3" fill="currentColor" />
    <circle cx="110" cy="180" r="4" fill="currentColor" />
    <circle cx="160" cy="140" r="3" fill="none" stroke="currentColor" stroke-width="1.5" />
    <circle cx="40" cy="240" r="3.5" fill="currentColor" />
    <circle cx="110" cy="300" r="3.5" fill="none" stroke="currentColor" stroke-width="1.5" />
    <circle cx="140" cy="290" r="3" fill="currentColor" />
    <circle cx="60" cy="380" r="3" fill="currentColor" />
    <circle cx="110" cy="430" r="2.5" fill="currentColor" />

    <!-- Monospace Micro Label -->
    <text x="48" y="86" class="arch-label">SYS//01</text>
    <text x="118" y="296" class="arch-label">BUS:A</text>
  </svg>

  <!-- Right Peripheral Wing (Outer Right Gutter) -->
  <svg class="arch-wing arch-wing-right" viewBox="0 0 240 500" fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- Registration Crosshairs -->
    <path d="M190,40 L190,52 M184,46 L196,46" stroke="currentColor" stroke-width="1" />
    <path d="M90,420 L90,432 M84,426 L96,426" stroke="currentColor" stroke-width="1" />

    <!-- Topology Network Traces -->
    <line x1="80" y1="100" x2="180" y2="60" stroke="currentColor" stroke-width="1.2" stroke-dasharray="4 4" />
    <polyline points="80,100 130,170 200,140" stroke="currentColor" stroke-width="1.2" />
    <line x1="130" y1="170" x2="130" y2="280" stroke="currentColor" stroke-width="1.2" stroke-dasharray="5 5" />
    <polyline points="130,280 70,330 140,390" stroke="currentColor" stroke-width="1.2" />
    <line x1="140" y1="390" x2="210" y2="360" stroke="currentColor" stroke-width="1.2" />
    <path d="M200,140 L200,220 L160,220" stroke="currentColor" stroke-width="1.2" />

    <!-- Nodes -->
    <circle cx="180" cy="60" r="3.5" fill="currentColor" />
    <circle cx="80" cy="100" r="3.5" fill="none" stroke="currentColor" stroke-width="1.5" />
    <circle cx="130" cy="170" r="4.5" fill="currentColor" />
    <circle cx="200" cy="140" r="3" fill="currentColor" />
    <circle cx="160" cy="220" r="2.5" fill="currentColor" />
    <circle cx="130" cy="280" r="3.5" fill="none" stroke="currentColor" stroke-width="1.5" />
    <circle cx="70" cy="330" r="3" fill="currentColor" />
    <circle cx="140" cy="390" r="4" fill="currentColor" />
    <circle cx="210" cy="360" r="3" fill="none" stroke="currentColor" stroke-width="1.5" />

    <!-- Monospace Micro Label -->
    <text x="138" y="164" class="arch-label">NODE:02</text>
    <text x="148" y="386" class="arch-label">GATE//B</text>
  </svg>
</div>

<style>
  .arch-bg-fixed {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
    /* Completely hidden on mobile screens */
    display: none;
  }

  .arch-wing {
    position: absolute;
    pointer-events: none;
    color: #000000;
    opacity: 0.07;
    transition: opacity var(--transition-smooth), color var(--transition-smooth);
  }

  /* Left Wing: Pinned to Left Gutter */
  .arch-wing-left {
    top: 130px;
    left: 0;
    width: clamp(120px, 12vw, 200px);
    height: auto;
    max-height: 480px;
  }

  /* Right Wing: Pinned to Right Gutter */
  .arch-wing-right {
    top: 80px;
    right: 0;
    width: clamp(140px, 14vw, 240px);
    height: auto;
    max-height: 500px;
  }

  /* Dark mode */
  :global([data-theme='dark']) .arch-wing {
    color: var(--color-accent);
    opacity: 0.09;
  }

  .arch-label {
    font-family: var(--font-mono);
    font-size: 7.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    fill: currentColor;
    opacity: 0.65;
    user-select: none;
  }

  /* Tablet: Show right wing faintly; hide left wing */
  @media (min-width: 768px) {
    .arch-bg-fixed {
      display: block;
    }

    .arch-wing-left {
      display: none;
    }

    .arch-wing-right {
      opacity: 0.05;
    }

    :global([data-theme='dark']) .arch-wing-right {
      opacity: 0.07;
    }
  }

  /* Desktop: Show both peripheral wings in outer gutters */
  @media (min-width: 1024px) {
    .arch-wing-left {
      display: block;
      opacity: 0.07;
    }

    .arch-wing-right {
      opacity: 0.08;
    }

    :global([data-theme='dark']) .arch-wing-left {
      opacity: 0.09;
    }

    :global([data-theme='dark']) .arch-wing-right {
      opacity: 0.10;
    }
  }

  /* Ultra-wide screens: Crisp presentation */
  @media (min-width: 1440px) {
    .arch-wing-left {
      opacity: 0.08;
    }

    .arch-wing-right {
      opacity: 0.09;
    }

    :global([data-theme='dark']) .arch-wing-left {
      opacity: 0.10;
    }

    :global([data-theme='dark']) .arch-wing-right {
      opacity: 0.11;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .arch-wing {
      transition: none !important;
    }
  }
</style>
