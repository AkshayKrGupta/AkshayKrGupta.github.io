---
// ArchitectureBackground.astro
// Architectural topology visual signature positioned behind article text
// Pure static SVG with zero runtime JavaScript
---

<div class="arch-bg-fixed" aria-hidden="true">
  <svg
    class="arch-bg-svg"
    viewBox="0 0 1440 900"
    preserveAspectRatio="xMidYMid slice"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <!-- Crosshairs & Blueprint Markers -->
    <path d="M180,80 L180,96 M172,88 L196,88" class="arch-line" stroke="currentColor" stroke-width="1" />
    <path d="M1260,60 L1260,76 M1252,68 L1276,68" class="arch-line" stroke="currentColor" stroke-width="1" />
    <path d="M1100,520 L1100,536 M1092,528 L1116,528" class="arch-line" stroke="currentColor" stroke-width="1" />
    <path d="M220,740 L220,756 M212,748 L236,748" class="arch-line" stroke="currentColor" stroke-width="1" />

    <!-- Upper Section Network (Behind Header & Upper Prose) -->
    <!-- Solid & Dashed Connection Lines -->
    <line x1="120" y1="140" x2="340" y2="220" class="arch-line" stroke="currentColor" stroke-width="1.2" />
    <line x1="340" y1="220" x2="560" y2="160" class="arch-line" stroke="currentColor" stroke-width="1.2" stroke-dasharray="6 6" />
    <line x1="560" y1="160" x2="780" y2="240" class="arch-line" stroke="currentColor" stroke-width="1.2" />
    <line x1="780" y1="240" x2="1020" y2="150" class="arch-line" stroke="currentColor" stroke-width="1.2" stroke-dasharray="5 5" />
    <line x1="1020" y1="150" x2="1220" y2="190" class="arch-line" stroke="currentColor" stroke-width="1.2" />
    <line x1="1220" y1="190" x2="1380" y2="110" class="arch-line" stroke="currentColor" stroke-width="1.2" stroke-dasharray="4 4" />

    <!-- Branching Bus Lines -->
    <polyline points="340,220 340,320 460,320 540,400" class="arch-line" stroke="currentColor" stroke-width="1.2" stroke-dasharray="4 4" />
    <polyline points="780,240 860,340 980,340" class="arch-line" stroke="currentColor" stroke-width="1.2" />
    <polyline points="1020,150 1120,70 1280,70" class="arch-line" stroke="currentColor" stroke-width="1.2" stroke-dasharray="3 3" />
    <polyline points="1220,190 1220,310 1340,310" class="arch-line" stroke="currentColor" stroke-width="1.2" />

    <!-- Upper Section Nodes -->
    <circle cx="120" cy="140" r="4" fill="currentColor" />
    <circle cx="340" cy="220" r="4.5" fill="currentColor" />
    <circle cx="560" cy="160" r="3.5" fill="none" stroke="currentColor" stroke-width="2" />
    <circle cx="780" cy="240" r="4.5" fill="currentColor" />
    <circle cx="1020" cy="150" r="3.5" fill="none" stroke="currentColor" stroke-width="2" />
    <circle cx="1220" cy="190" r="4.5" fill="currentColor" />
    <circle cx="1380" cy="110" r="4" fill="currentColor" />
    <circle cx="540" cy="400" r="3.5" fill="currentColor" />
    <circle cx="980" cy="340" r="3.5" fill="none" stroke="currentColor" stroke-width="2" />
    <circle cx="1280" cy="70" r="3" fill="currentColor" />
    <circle cx="1340" cy="310" r="3.5" fill="currentColor" />

    <!-- Lower Section Network (Behind Mid/Lower Prose) -->
    <!-- Solid & Dashed Connection Lines -->
    <line x1="80" y1="620" x2="260" y2="540" class="arch-line" stroke="currentColor" stroke-width="1.2" stroke-dasharray="5 5" />
    <line x1="260" y1="540" x2="480" y2="640" class="arch-line" stroke="currentColor" stroke-width="1.2" />
    <line x1="480" y1="640" x2="720" y2="580" class="arch-line" stroke="currentColor" stroke-width="1.2" stroke-dasharray="6 6" />
    <line x1="720" y1="580" x2="940" y2="680" class="arch-line" stroke="currentColor" stroke-width="1.2" />
    <line x1="940" y1="680" x2="1180" y2="610" class="arch-line" stroke="currentColor" stroke-width="1.2" stroke-dasharray="4 4" />
    <line x1="1180" y1="610" x2="1360" y2="720" class="arch-line" stroke="currentColor" stroke-width="1.2" />

    <!-- Lower Branching Traces -->
    <polyline points="260,540 260,450 360,450" class="arch-line" stroke="currentColor" stroke-width="1.2" />
    <polyline points="720,580 640,490 520,490" class="arch-line" stroke="currentColor" stroke-width="1.2" stroke-dasharray="3 3" />
    <polyline points="940,680 940,780 1060,780" class="arch-line" stroke="currentColor" stroke-width="1.2" stroke-dasharray="4 4" />
    <polyline points="1180,610 1260,520 1380,520" class="arch-line" stroke="currentColor" stroke-width="1.2" />

    <!-- Lower Section Nodes -->
    <circle cx="80" cy="620" r="3.5" fill="currentColor" />
    <circle cx="260" cy="540" r="4.5" fill="currentColor" />
    <circle cx="480" cy="640" r="3.5" fill="none" stroke="currentColor" stroke-width="2" />
    <circle cx="720" cy="580" r="4.5" fill="currentColor" />
    <circle cx="940" cy="680" r="3.5" fill="none" stroke="currentColor" stroke-width="2" />
    <circle cx="1180" cy="610" r="4.5" fill="currentColor" />
    <circle cx="1360" cy="720" r="4" fill="currentColor" />
    <circle cx="360" cy="450" r="3" fill="none" stroke="currentColor" stroke-width="1.5" />
    <circle cx="520" cy="490" r="3.5" fill="currentColor" />
    <circle cx="1060" cy="780" r="3" fill="none" stroke="currentColor" stroke-width="1.5" />
    <circle cx="1380" cy="520" r="3.5" fill="currentColor" />

    <!-- Micro Monospace Labels -->
    <text x="350" y="212" class="arch-label">NODE:01</text>
    <text x="790" y="232" class="arch-label">GATE//A</text>
    <text x="1230" y="182" class="arch-label">CLUSTER:03</text>
    <text x="270" y="532" class="arch-label">INGRESS:02</text>
    <text x="730" y="572" class="arch-label">ROUTER:04</text>
    <text x="1190" y="602" class="arch-label">EGRESS:01</text>
  </svg>
</div>

<style>
  .arch-bg-fixed {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .arch-bg-svg {
    width: 100%;
    height: 100%;
    display: block;
    color: #000000;
    opacity: 0.13;
    transition: opacity var(--transition-smooth), color var(--transition-smooth);
  }

  /* Dark mode */
  :global([data-theme='dark']) .arch-bg-svg {
    color: var(--color-accent);
    opacity: 0.16;
  }

  .arch-label {
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 0.12em;
    fill: currentColor;
    opacity: 0.75;
    user-select: none;
  }

  @media (min-width: 768px) {
    .arch-bg-svg {
      opacity: 0.16;
    }
    :global([data-theme='dark']) .arch-bg-svg {
      opacity: 0.20;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .arch-bg-svg {
      transition: none !important;
    }
  }
</style>
