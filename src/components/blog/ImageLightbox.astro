---
/**
 * ImageLightbox.astro
 * Zero-dependency, accessible, high-performance image lightbox.
 * Automatically activates on all article figures, markdown images, and hero images
 * without requiring any special markup or changes in MDX authoring.
 */
---

<dialog id="image-lightbox-dialog" class="image-lightbox" aria-label="Image Zoom Viewer" aria-modal="true">
  <div class="lightbox-backdrop"></div>
  
  <div class="lightbox-toolbar">
    <div class="lightbox-info">
      <span id="lightbox-counter" class="lightbox-counter font-mono">1 / 1</span>
      <span id="lightbox-zoom-level" class="lightbox-zoom-badge font-mono">100%</span>
    </div>
    
    <div class="lightbox-controls font-mono">
      <button id="lightbox-zoom-out" class="lightbox-btn" type="button" aria-label="Zoom out" title="Zoom out (-)">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          <line x1="8" y1="11" x2="14" y2="11"></line>
        </svg>
      </button>
      
      <button id="lightbox-zoom-reset" class="lightbox-btn" type="button" aria-label="Reset zoom" title="Reset zoom (1:1)">
        <span class="btn-text">1:1</span>
      </button>

      <button id="lightbox-zoom-in" class="lightbox-btn" type="button" aria-label="Zoom in" title="Zoom in (+)">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          <line x1="11" y1="8" x2="11" y2="14"></line>
          <line x1="8" y1="11" x2="14" y2="11"></line>
        </svg>
      </button>

      <button id="lightbox-close" class="lightbox-btn lightbox-btn-close" type="button" aria-label="Close viewer" title="Close (Esc)">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <div class="lightbox-stage" id="lightbox-stage">
    <div class="lightbox-img-wrapper" id="lightbox-img-wrapper">
      <img id="lightbox-img" src="" alt="" draggable="false" />
    </div>
  </div>

  <div class="lightbox-caption-bar" id="lightbox-caption-bar">
    <p id="lightbox-caption" class="lightbox-caption-text font-mono"></p>
  </div>
</dialog>

<style>
  .image-lightbox {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    overflow: hidden;
    z-index: 9999;
    display: none;
    flex-direction: column;
    color: #e6edf3;
  }

  .image-lightbox[open] {
    display: flex;
    animation: lightboxFadeIn 200ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes lightboxFadeIn {
    from {
      opacity: 0;
      backdrop-filter: blur(0px);
    }
    to {
      opacity: 1;
      backdrop-filter: blur(16px);
    }
  }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(10, 12, 16, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 1;
  }

  .lightbox-toolbar {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    background: linear-gradient(to bottom, rgba(10, 12, 16, 0.8) 0%, rgba(10, 12, 16, 0) 100%);
    pointer-events: none;
  }

  .lightbox-toolbar > * {
    pointer-events: auto;
  }

  .lightbox-info {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .lightbox-counter {
    font-size: 0.75rem;
    color: #8b949e;
    letter-spacing: 0.05em;
  }

  .lightbox-zoom-badge {
    font-size: 0.6875rem;
    padding: 2px 6px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-xs);
    color: #58a6ff;
  }

  .lightbox-controls {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .lightbox-btn {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #e6edf3;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .lightbox-btn:hover {
    background-color: rgba(255, 255, 255, 0.18);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.3);
  }

  .lightbox-btn:active {
    transform: scale(0.96);
  }

  .lightbox-btn .btn-text {
    font-size: 0.6875rem;
    font-weight: 700;
  }

  .lightbox-btn-close {
    background-color: rgba(235, 50, 35, 0.18);
    border-color: rgba(235, 50, 35, 0.3);
    color: #ff7b72;
    margin-left: 6px;
  }

  .lightbox-btn-close:hover {
    background-color: rgba(235, 50, 35, 0.35);
    color: #ffffff;
  }

  .lightbox-stage {
    position: relative;
    z-index: 5;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    touch-action: none;
    user-select: none;
  }

  .lightbox-img-wrapper {
    position: relative;
    max-width: 95vw;
    max-height: 82vh;
    display: flex;
    align-items: center;
    justify-content: center;
    transform-origin: center center;
    transition: transform 60ms linear;
    will-change: transform;
    cursor: grab;
  }

  .lightbox-img-wrapper.is-panning {
    cursor: grabbing;
    transition: none;
  }

  #lightbox-img {
    max-width: 92vw;
    max-height: 80vh;
    object-fit: contain;
    border-radius: var(--radius-sm);
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.75);
    pointer-events: none;
  }

  .lightbox-caption-bar {
    position: relative;
    z-index: 10;
    padding: 12px 20px;
    background: linear-gradient(to top, rgba(10, 12, 16, 0.85) 0%, rgba(10, 12, 16, 0) 100%);
    text-align: center;
    pointer-events: none;
  }

  .lightbox-caption-text {
    font-size: 0.8125rem;
    color: #cbd5e1;
    max-width: 800px;
    margin: 0 auto;
    line-height: 1.4;
  }

  /* Global styles applied to zoomable images */
  :global(.prose-content img),
  :global(.post-hero-image) {
    cursor: zoom-in !important;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  @media (hover: hover) and (pointer: fine) {
    :global(.prose-content figure:hover .figure-image),
    :global(.post-hero-image-wrap:hover .post-hero-image) {
      box-shadow: var(--shadow-float);
    }
  }
</style>

<script is:inline>
  (function () {
    let images = [];
    let currentIndex = 0;
    let scale = 1;
    let translateX = 0;
    let translateY = 0;
    let isDragging = false;
    let startX = 0;
    let startY = 0;
    let lastTouchDistance = 0;

    const MIN_SCALE = 0.5;
    const MAX_SCALE = 4.5;
    const SCALE_STEP = 0.35;

    function getElements() {
      return {
        dialog: document.getElementById('image-lightbox-dialog'),
        img: document.getElementById('lightbox-img'),
        wrapper: document.getElementById('lightbox-img-wrapper'),
        stage: document.getElementById('lightbox-stage'),
        caption: document.getElementById('lightbox-caption'),
        captionBar: document.getElementById('lightbox-caption-bar'),
        counter: document.getElementById('lightbox-counter'),
        zoomBadge: document.getElementById('lightbox-zoom-level'),
        zoomInBtn: document.getElementById('lightbox-zoom-in'),
        zoomOutBtn: document.getElementById('lightbox-zoom-out'),
        zoomResetBtn: document.getElementById('lightbox-zoom-reset'),
        closeBtn: document.getElementById('lightbox-close'),
        backdrop: document.querySelector('.lightbox-backdrop'),
      };
    }

    function updateTransform() {
      const { wrapper, zoomBadge } = getElements();
      if (!wrapper) return;
      wrapper.style.transform = `translate3d(${translateX}px, ${translateY}px, 0) scale(${scale})`;
      if (zoomBadge) {
        zoomBadge.textContent = `${Math.round(scale * 100)}%`;
      }
    }

    function resetTransform() {
      scale = 1;
      translateX = 0;
      translateY = 0;
      updateTransform();
    }

    function openLightbox(index) {
      const els = getElements();
      if (!els.dialog || !els.img || images.length === 0) return;

      currentIndex = index;
      const target = images[currentIndex];
      if (!target) return;

      els.img.src = target.src;
      els.img.alt = target.alt || '';

      const captionText = target.caption || target.alt || '';
      if (captionText) {
        els.caption.textContent = captionText;
        els.captionBar.style.display = 'block';
      } else {
        els.captionBar.style.display = 'none';
      }

      els.counter.textContent = `${currentIndex + 1} / ${images.length}`;
      resetTransform();

      els.dialog.showModal();
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      const els = getElements();
      if (!els.dialog) return;
      els.dialog.close();
      document.body.style.overflow = '';
      resetTransform();
    }

    function zoom(delta, originX, originY) {
      const prevScale = scale;
      scale = Math.min(MAX_SCALE, Math.max(MIN_SCALE, scale + delta));

      if (originX !== undefined && originY !== undefined && prevScale !== scale) {
        // Zoom toward cursor/touch center
        const ratio = scale / prevScale - 1;
        translateX -= (originX - translateX) * ratio;
        translateY -= (originY - translateY) * ratio;
      }
      updateTransform();
    }

    function initLightboxBindings() {
      const els = getElements();
      if (!els.dialog || els.dialog.dataset.initialized) return;
      els.dialog.dataset.initialized = 'true';

      // Controls
      els.closeBtn?.addEventListener('click', closeLightbox);
      els.backdrop?.addEventListener('click', closeLightbox);
      els.zoomInBtn?.addEventListener('click', () => zoom(SCALE_STEP));
      els.zoomOutBtn?.addEventListener('click', () => zoom(-SCALE_STEP));
      els.zoomResetBtn?.addEventListener('click', resetTransform);

      // Keyboard navigation
      els.dialog.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          e.preventDefault();
          closeLightbox();
        } else if (e.key === '+' || e.key === '=') {
          zoom(SCALE_STEP);
        } else if (e.key === '-') {
          zoom(-SCALE_STEP);
        } else if (e.key === '0') {
          resetTransform();
        } else if (e.key === 'ArrowRight' && images.length > 1) {
          openLightbox((currentIndex + 1) % images.length);
        } else if (e.key === 'ArrowLeft' && images.length > 1) {
          openLightbox((currentIndex - 1 + images.length) % images.length);
        }
      });

      // Mouse Wheel Zoom
      els.stage?.addEventListener(
        'wheel',
        (e) => {
          e.preventDefault();
          const delta = e.deltaY < 0 ? SCALE_STEP : -SCALE_STEP;
          const rect = els.wrapper.getBoundingClientRect();
          zoom(delta, e.clientX - rect.left - rect.width / 2, e.clientY - rect.top - rect.height / 2);
        },
        { passive: false }
      );

      // Mouse Drag / Pan
      els.wrapper?.addEventListener('mousedown', (e) => {
        if (scale <= 1 && e.button !== 0) return;
        isDragging = true;
        startX = e.clientX - translateX;
        startY = e.clientY - translateY;
        els.wrapper.classList.add('is-panning');
      });

      window.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        translateX = e.clientX - startX;
        translateY = e.clientY - startY;
        updateTransform();
      });

      window.addEventListener('mouseup', () => {
        if (isDragging) {
          isDragging = false;
          els.wrapper?.classList.remove('is-panning');
        }
      });

      // Double Click / Double Tap to Toggle 2x Zoom
      let lastTap = 0;
      els.stage?.addEventListener('click', (e) => {
        if (e.target === els.stage || e.target === els.backdrop) {
          closeLightbox();
        }
      });

      els.img?.parentElement?.addEventListener('dblclick', (e) => {
        if (scale > 1) {
          resetTransform();
        } else {
          scale = 2.2;
          const rect = els.wrapper.getBoundingClientRect();
          translateX = -(e.clientX - rect.left - rect.width / 2) * 1.2;
          translateY = -(e.clientY - rect.top - rect.height / 2) * 1.2;
          updateTransform();
        }
      });

      // Mobile Touch Handling (Pan & Pinch to Zoom)
      els.stage?.addEventListener(
        'touchstart',
        (e) => {
          if (e.touches.length === 1) {
            const now = Date.now();
            if (now - lastTap < 300) {
              // Double tap
              if (scale > 1) {
                resetTransform();
              } else {
                scale = 2.2;
                updateTransform();
              }
            }
            lastTap = now;

            isDragging = true;
            startX = e.touches[0].clientX - translateX;
            startY = e.touches[0].clientY - translateY;
          } else if (e.touches.length === 2) {
            // Pinch start
            isDragging = false;
            lastTouchDistance = Math.hypot(
              e.touches[0].clientX - e.touches[1].clientX,
              e.touches[0].clientY - e.touches[1].clientY
            );
          }
        },
        { passive: true }
      );

      els.stage?.addEventListener(
        'touchmove',
        (e) => {
          if (e.touches.length === 1 && isDragging) {
            translateX = e.touches[0].clientX - startX;
            translateY = e.touches[0].clientY - startY;
            updateTransform();
          } else if (e.touches.length === 2) {
            const distance = Math.hypot(
              e.touches[0].clientX - e.touches[1].clientX,
              e.touches[0].clientY - e.touches[1].clientY
            );
            if (lastTouchDistance > 0) {
              const delta = (distance - lastTouchDistance) * 0.008;
              scale = Math.min(MAX_SCALE, Math.max(MIN_SCALE, scale + delta));
              updateTransform();
            }
            lastTouchDistance = distance;
          }
        },
        { passive: true }
      );

      els.stage?.addEventListener('touchend', () => {
        isDragging = false;
        lastTouchDistance = 0;
      });
    }

    // Auto-discover all zoomable article images
    function collectArticleImages() {
      images = [];
      const articleImgs = document.querySelectorAll(
        '.prose-content img, .post-hero-image, .figure-image'
      );

      articleImgs.forEach((img, idx) => {
        // Find nearest caption if within a <figure>
        const figure = img.closest('figure');
        const captionEl = figure?.querySelector('figcaption');
        const caption = captionEl ? captionEl.textContent.trim() : (img.getAttribute('alt') || '');

        images.push({
          src: img.currentSrc || img.src,
          alt: img.alt || '',
          caption: caption,
          el: img,
        });

        img.setAttribute('role', 'button');
        img.setAttribute('tabindex', '0');
        img.setAttribute('aria-label', `Zoom image: ${caption || 'View larger'}`);

        const clickHandler = () => openLightbox(idx);
        img.removeEventListener('click', img._lightboxHandler);
        img.addEventListener('click', clickHandler);
        img._lightboxHandler = clickHandler;

        img.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            openLightbox(idx);
          }
        });
      });
    }

    function initAll() {
      initLightboxBindings();
      collectArticleImages();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }

    document.addEventListener('astro:page-load', initAll);
    document.addEventListener('astro:after-swap', initAll);
  })();
</script>
