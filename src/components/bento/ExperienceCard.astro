---
import { experiences } from '../../data/experience';
import BentoCard from './BentoCard.astro';
import Badge from '../common/Badge.astro';

interface Props {
  colSpan?: '12' | '8' | '7' | '6';
}

const { colSpan = '12' } = Astro.props;

const companyBadges: Record<string, string> = {
  'London Stock Exchange Group': 'LSEG',
  'Wipro Limited': 'WIPRO',
  'Infosys Limited': 'INFY',
};

// Helper to extract 4-digit year for the roadmap node tag
const getYearOnly = (dateStr: string) => {
  const match = dateStr.match(/\d{4}/);
  return match ? match[0] : dateStr;
};
---

<BentoCard id="experience" variant="raised" colSpan={colSpan} class="experience-card">
  <div class="roadmap-header">
    <div class="header-left">
      <p class="swiss-kicker">Career Roadmap</p>
      <h3 class="swiss-heading-3">Professional Trajectory</h3>
    </div>
    <div class="header-badge font-mono">
      <span class="pulse-dot"></span>
      <span>14+ years across engineering, architecture & technology leadership</span>
    </div>
  </div>

  <!-- 1. Desktop View: Horizontal Single-Row Roadmap with Popovers -->
  <div class="desktop-roadmap" aria-label="Career Timeline Desktop">
    <div class="roadmap-track">
      <!-- Background Continuous Line -->
      <div class="roadmap-line" aria-hidden="true"></div>

      <!-- 5 Milestones in a Single Row -->
      <div class="roadmap-milestones">
        {experiences.map((exp, index) => {
          const badge = companyBadges[exp.company] || exp.company.substring(0, 4).toUpperCase();
          const popoverPos = index === 0 ? 'pos-start' : index === experiences.length - 1 ? 'pos-end' : 'pos-center';
          const yearDisplay = getYearOnly(exp.startDate);
          return (
            <div class={`roadmap-point ${exp.current ? 'is-active' : ''} ${popoverPos}`} tabindex="0">
              <!-- Year Indicator (Above Line) -->
              <div class="point-year font-mono">
                <span>{yearDisplay}</span>
                {exp.current && <span class="badge-now font-mono">NOW</span>}
              </div>

              <!-- Milestone Node on the Line -->
              <div class="node-wrapper">
                <div class="node-dot">
                  {exp.current && <span class="active-glow" />}
                </div>
              </div>

              <!-- Vertical Fading Stem -->
              <div class="point-stem" aria-hidden="true" />

              <!-- Job Title -->
              <div class="point-title-wrap">
                <span class="point-title">{exp.role}</span>
              </div>

              <!-- Popover Floating Card on Hover / Focus -->
              <div class={`roadmap-popover ${popoverPos}`} role="tooltip">
                <div class="popover-arrow" />
                <div class="popover-header">
                  <span class="popover-badge font-mono">{badge}</span>
                  <span class="popover-period font-mono">{exp.startDate} &mdash; {exp.endDate}</span>
                </div>
                <h4 class="popover-role">{exp.role}</h4>
                <p class="popover-company font-mono">{exp.company}</p>
                {exp.location && (
                  <div class="popover-footer">
                    <span class="popover-location text-muted">{exp.location}</span>
                    {exp.current && <Badge variant="accent" size="sm">Current Role</Badge>}
                  </div>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>

  <!-- 2. Mobile View: Clean Vertical Connected Timeline -->
  <div class="mobile-timeline" aria-label="Career Timeline Mobile">
    <div class="mobile-track">
      <div class="mobile-vertical-line" aria-hidden="true" />
      
      <div class="mobile-milestones">
        {experiences.map((exp) => {
          const badge = companyBadges[exp.company] || exp.company.substring(0, 4).toUpperCase();
          return (
            <div class={`mobile-step ${exp.current ? 'is-active' : ''}`}>
              <!-- Node on the vertical track -->
              <div class="mobile-node">
                {exp.current && <span class="active-glow" />}
                <span class="mobile-node-dot" />
              </div>

              <!-- Content Card -->
              <div class="mobile-step-card">
                <div class="mobile-top-row">
                  <span class="mobile-year font-mono">
                    {exp.startDate} &mdash; {exp.endDate}
                  </span>
                  <span class="popover-badge font-mono">{badge}</span>
                </div>

                <h4 class="mobile-role">{exp.role}</h4>
                <p class="mobile-company font-mono text-muted">{exp.company}</p>

                {exp.location && (
                  <div class="mobile-footer">
                    <span class="mobile-location text-muted">{exp.location}</span>
                    {exp.current && <Badge variant="accent" size="sm">Current</Badge>}
                  </div>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</BentoCard>

<style>
  :global(#experience.bento-card),
  .experience-card {
    overflow: visible !important;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    position: relative;
    z-index: 10;
  }

  .roadmap-header {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-3);
  }

  @media (min-width: 640px) {
    .roadmap-header {
      flex-direction: row;
      align-items: center;
    }
  }

  .header-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-accent);
    background-color: var(--color-accent-subtle);
    border: 1px solid rgba(88, 166, 255, 0.2);
    padding: 4px 12px;
    border-radius: var(--radius-full);
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background-color: var(--color-accent);
    box-shadow: 0 0 6px var(--color-accent);
  }

  /* ==========================================================================
     MOBILE VIEW (Default Baseline: < 768px)
     ========================================================================== */
  .desktop-roadmap {
    display: none;
  }

  .mobile-timeline {
    display: block;
    position: relative;
    padding: var(--space-2) 0;
  }

  .mobile-track {
    position: relative;
    padding-left: var(--space-6);
  }

  .mobile-vertical-line {
    position: absolute;
    top: 8px;
    bottom: 12px;
    left: 8px;
    width: 2px;
    background: linear-gradient(
      180deg,
      var(--color-accent) 0%,
      var(--color-accent) 30%,
      var(--color-border) 100%
    );
  }

  .mobile-milestones {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .mobile-step {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .mobile-node {
    position: absolute;
    top: 10px;
    left: calc(-1 * var(--space-6) + 3px);
    width: 12px;
    height: 12px;
    z-index: 2;
  }

  .mobile-node-dot {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-full);
    background-color: var(--color-surface);
    border: 2px solid var(--color-border);
    box-shadow: 0 0 0 2px var(--color-bg);
  }

  .mobile-step.is-active .mobile-node-dot {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    box-shadow: 0 0 0 2px var(--color-bg), 0 0 8px var(--color-accent);
  }

  .mobile-step-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 4px;
    transition: border-color var(--transition-fast);
  }

  .mobile-step.is-active .mobile-step-card {
    border-color: var(--color-accent-subtle);
    background: linear-gradient(180deg, var(--color-surface) 0%, var(--color-surface-hover) 100%);
  }

  .mobile-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2px;
  }

  .mobile-year {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-accent);
  }

  .mobile-role {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text);
  }

  .mobile-company {
    font-size: 0.75rem;
  }

  .mobile-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border-subtle);
    margin-top: 2px;
  }

  .mobile-location {
    font-size: 0.75rem;
  }

  /* ==========================================================================
     DESKTOP VIEW (Breakpoints: ≥ 768px)
     ========================================================================== */
  @media (min-width: 768px) {
    .mobile-timeline {
      display: none !important;
    }

    .desktop-roadmap {
      display: block !important;
      position: relative;
      padding-top: var(--space-3);
      padding-bottom: var(--space-4);
    }

    .roadmap-track {
      position: relative;
      width: 100%;
    }

    /* Continuous Horizontal Track Line */
    .roadmap-line {
      position: absolute;
      top: 40px;
      left: 40px;
      right: 40px;
      height: 2px;
      background: linear-gradient(
        90deg,
        var(--color-accent) 0%,
        var(--color-accent) 25%,
        var(--color-border) 80%,
        var(--color-border-subtle) 100%
      );
      z-index: 1;
    }

    /* 5 Milestones in a Single Row */
    .roadmap-milestones {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      position: relative;
      z-index: 2;
    }

    .roadmap-point {
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
      cursor: pointer;
      outline: none;
      padding: 0 var(--space-2);
    }

    /* Year Tag (Above Line) */
    .point-year {
      display: flex;
      align-items: center;
      gap: 4px;
      font-size: var(--text-xs);
      font-weight: 800;
      color: var(--color-text-muted);
      letter-spacing: 0.05em;
      margin-bottom: var(--space-2);
      height: 22px;
      transition: color var(--transition-fast);
    }

    .is-active .point-year,
    .roadmap-point:hover .point-year,
    .roadmap-point:focus-within .point-year {
      color: var(--color-accent);
    }

    .badge-now {
      font-size: 0.625rem;
      font-weight: 800;
      color: var(--color-accent);
      background-color: var(--color-accent-subtle);
      padding: 1px 5px;
      border-radius: var(--radius-xs);
    }

    /* Node Dot on the Line */
    .node-wrapper {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      z-index: 3;
    }

    .node-dot {
      width: 12px;
      height: 12px;
      border-radius: var(--radius-full);
      background-color: var(--color-surface);
      border: 2.5px solid var(--color-border);
      transition: all var(--transition-fast);
      position: relative;
      box-shadow: 0 0 0 3px var(--color-bg);
    }

    .is-active .node-dot {
      border-color: var(--color-accent);
      background-color: var(--color-accent);
      box-shadow: 0 0 0 3px var(--color-bg), 0 0 10px var(--color-accent);
    }

    .active-glow {
      position: absolute;
      top: -5px;
      left: -5px;
      width: 18px;
      height: 18px;
      border-radius: var(--radius-full);
      border: 1.5px solid var(--color-accent);
      opacity: 0.6;
      animation: glow-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    @keyframes glow-pulse {
      0%, 100% { transform: scale(0.9); opacity: 0.7; }
      50% { transform: scale(1.4); opacity: 0; }
    }

    .roadmap-point:hover .node-dot,
    .roadmap-point:focus-within .node-dot {
      border-color: var(--color-accent);
      background-color: var(--color-accent);
      transform: scale(1.25);
      box-shadow: 0 0 0 3px var(--color-bg), 0 0 12px var(--color-accent);
    }

    /* Vertical Fading Stem */
    .point-stem {
      width: 2px;
      height: 18px;
      background: linear-gradient(
        180deg,
        var(--color-border) 0%,
        rgba(88, 166, 255, 0) 100%
      );
      margin: 2px 0 6px 0;
      transition: all var(--transition-fast);
    }

    .is-active .point-stem,
    .roadmap-point:hover .point-stem,
    .roadmap-point:focus-within .point-stem {
      background: linear-gradient(
        180deg,
        var(--color-accent) 0%,
        rgba(88, 166, 255, 0.1) 100%
      );
      height: 22px;
    }

    /* Job Title Below Stem */
    .point-title-wrap {
      text-align: center;
      max-width: 130px;
      min-height: 40px;
    }

    .point-title {
      font-size: var(--text-xs);
      font-weight: 700;
      color: var(--color-text);
      line-height: var(--leading-tight);
      display: inline-block;
      transition: color var(--transition-fast), transform var(--transition-fast);
    }

    .is-active .point-title {
      color: var(--color-text);
      font-weight: 800;
    }

    .roadmap-point:hover .point-title,
    .roadmap-point:focus-within .point-title {
      color: var(--color-accent);
      transform: translateY(2px);
    }

    /* Popover Tooltip Floating Card (Pops out cleanly without clipping) */
    .roadmap-popover {
      position: absolute;
      top: 96px;
      width: 240px;
      background-color: var(--color-surface-raised);
      border: 1px solid var(--color-accent);
      border-radius: var(--radius-md);
      padding: var(--space-4);
      box-shadow: 0 16px 36px -4px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(88, 166, 255, 0.2);
      display: flex;
      flex-direction: column;
      gap: 6px;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      z-index: 100;
      transition: all var(--transition-smooth);
    }

    /* Center Position (Default) */
    .roadmap-popover.pos-center {
      left: 50%;
      transform: translateX(-50%) translateY(8px);
    }
    .roadmap-popover.pos-center .popover-arrow {
      left: 50%;
      transform: translateX(-50%) rotate(45deg);
    }

    /* Start Position (First item - aligns to left edge so it doesn't clip left) */
    .roadmap-popover.pos-start {
      left: 0;
      transform: translateY(8px);
    }
    .roadmap-popover.pos-start .popover-arrow {
      left: 28px;
      transform: rotate(45deg);
    }

    /* End Position (Last item - aligns to right edge so it doesn't clip right) */
    .roadmap-popover.pos-end {
      right: 0;
      left: auto;
      transform: translateY(8px);
    }
    .roadmap-popover.pos-end .popover-arrow {
      right: 28px;
      left: auto;
      transform: rotate(45deg);
    }

    .popover-arrow {
      position: absolute;
      top: -6px;
      width: 10px;
      height: 10px;
      background-color: var(--color-surface-raised);
      border-left: 1px solid var(--color-accent);
      border-top: 1px solid var(--color-accent);
    }

    .roadmap-point:hover .roadmap-popover.pos-center,
    .roadmap-point:focus-within .roadmap-popover.pos-center {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateX(-50%) translateY(0);
    }

    .roadmap-point:hover .roadmap-popover.pos-start,
    .roadmap-point:focus-within .roadmap-popover.pos-start,
    .roadmap-point:hover .roadmap-popover.pos-end,
    .roadmap-point:focus-within .roadmap-popover.pos-end {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
    }

    .popover-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
    }

    .popover-badge {
      font-size: 0.625rem;
      font-weight: 800;
      padding: 2px 7px;
      border-radius: var(--radius-xs);
      background-color: var(--color-accent-subtle);
      border: 1px solid rgba(88, 166, 255, 0.25);
      color: var(--color-accent);
      letter-spacing: 0.05em;
    }

    .popover-period {
      font-size: 0.6875rem;
      color: var(--color-text-muted);
    }

    .popover-role {
      font-size: var(--text-sm);
      font-weight: 700;
      color: var(--color-text);
      line-height: var(--leading-snug);
      margin-top: 2px;
    }

    .popover-company {
      font-size: 0.75rem;
      color: var(--color-text-subtle);
    }

    .popover-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: var(--space-2);
      border-top: 1px solid var(--color-border-subtle);
      margin-top: 2px;
    }

    .popover-location {
      font-size: 0.75rem;
    }
  }
</style>
