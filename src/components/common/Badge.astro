---
interface Props {
  variant?: 'neutral' | 'accent' | 'success' | 'outline';
  size?: 'sm' | 'md';
  class?: string;
}

const { variant = 'neutral', size = 'sm', class: className = '' } = Astro.props;
---

<span class={`badge badge-${variant} badge-${size} ${className}`}>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-weight: 500;
    border-radius: var(--radius-full);
    line-height: 1;
    white-space: nowrap;
    transition: all var(--transition-fast);
  }

  .badge-sm {
    font-size: 0.75rem;
    padding: 3px 8px;
  }

  .badge-md {
    font-size: 0.8125rem;
    padding: 5px 12px;
  }

  .badge-neutral {
    background-color: var(--color-surface);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-neu-sm);
  }

  .badge-accent {
    background-color: var(--color-accent-subtle);
    color: var(--color-accent);
    border: 1px solid rgba(36, 87, 255, 0.2);
  }

  .badge-success {
    background-color: var(--color-success-subtle);
    color: var(--color-success);
    border: 1px solid rgba(27, 135, 63, 0.2);
  }

  .badge-outline {
    background-color: transparent;
    color: var(--color-text-subtle);
    border: 1px dashed var(--color-border);
  }
</style>
