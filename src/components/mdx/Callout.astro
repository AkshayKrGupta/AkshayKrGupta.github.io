---
interface Props {
  type?: 'info' | 'tip' | 'warning' | 'important';
  title?: string;
}

const { type = 'info', title } = Astro.props;

const defaultTitles = {
  info: 'Note',
  tip: 'Tip',
  warning: 'Warning',
  important: 'Important',
};

const calloutTitle = title || defaultTitles[type];
---

<aside class={`callout callout-${type}`} role="note">
  <div class="callout-header">
    <span class="callout-icon">
      {type === 'info' && (
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" x2="12" y1="16" y2="12"></line>
          <line x1="12" x2="12.01" y1="8" y2="8"></line>
        </svg>
      )}
      {type === 'tip' && (
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"></path>
          <path d="M9 18h6"></path>
          <path d="M10 22h4"></path>
        </svg>
      )}
      {type === 'warning' && (
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
          <line x1="12" x2="12" y1="9" y2="13"></line>
          <line x1="12" x2="12.01" y1="17" y2="17"></line>
        </svg>
      )}
      {type === 'important' && (
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" x2="12" y1="8" y2="12"></line>
          <line x1="12" x2="12.01" y1="16" y2="16"></line>
        </svg>
      )}
    </span>
    <strong class="callout-title font-mono">{calloutTitle}</strong>
  </div>
  <div class="callout-body">
    <slot />
  </div>
</aside>

<style>
  .callout {
    margin: var(--space-6) 0;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    border-left: 4px solid;
    background-color: var(--color-surface);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .callout-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .callout-title {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .callout-body {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .callout-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .callout-info {
    border-color: var(--color-info);
    background-color: var(--color-info-subtle);
    color: var(--color-text);
  }
  .callout-info .callout-icon,
  .callout-info .callout-title {
    color: var(--color-info);
  }

  .callout-tip {
    border-color: var(--color-success);
    background-color: var(--color-success-subtle);
    color: var(--color-text);
  }
  .callout-tip .callout-icon,
  .callout-tip .callout-title {
    color: var(--color-success);
  }

  .callout-warning {
    border-color: var(--color-warning);
    background-color: var(--color-warning-subtle);
    color: var(--color-text);
  }
  .callout-warning .callout-icon,
  .callout-warning .callout-title {
    color: var(--color-warning);
  }

  .callout-important {
    border-color: var(--color-danger);
    background-color: var(--color-danger-subtle);
    color: var(--color-text);
  }
  .callout-important .callout-icon,
  .callout-important .callout-title {
    color: var(--color-danger);
  }
</style>
