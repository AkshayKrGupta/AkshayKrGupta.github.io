---
interface Props {
  code: string;
}

const { code } = Astro.props;
---

<div class="mermaid-wrapper" data-zoom="1">
  <!-- Interactive Zoom & Fullscreen Toolbar -->
  <div class="mermaid-toolbar font-mono" aria-label="Diagram Zoom Controls">
    <span class="modal-title" style="display: none;"></span>

    <div class="zoom-controls-group">
      <button type="button" class="tool-btn zoom-out-btn" title="Zoom Out" aria-label="Zoom Out">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          <line x1="8" y1="11" x2="14" y2="11"></line>
        </svg>
      </button>

      <span class="zoom-level-badge" title="Current Zoom">100%</span>

      <button type="button" class="tool-btn zoom-in-btn" title="Zoom In" aria-label="Zoom In">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          <line x1="11" y1="8" x2="11" y2="14"></line>
          <line x1="8" y1="11" x2="14" y2="11"></line>
        </svg>
      </button>

      <button type="button" class="tool-btn zoom-reset-btn" title="Reset Zoom (100%)" aria-label="Reset Zoom">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
          <path d="M3 3v5h5"></path>
        </svg>
      </button>
    </div>

    <!-- Toggle Fullscreen Expand Button -->
    <button type="button" class="tool-btn fullscreen-btn" title="Expand Fullscreen" aria-label="Toggle Fullscreen">
      <svg class="icon-expand" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
      </svg>
      <svg class="icon-collapse" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
        <path d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3"></path>
      </svg>
    </button>

    <!-- Dedicated Close Modal Button (Shown in Fullscreen Mode) -->
    <button type="button" class="tool-btn close-modal-btn" title="Close Fullscreen (Esc)" aria-label="Close Fullscreen" style="display: none;">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
      <span class="close-label">Close (Esc)</span>
    </button>
  </div>

  <!-- Diagram Canvas Area -->
  <div class="mermaid-viewport">
    <div class="mermaid-canvas">
      <div class="mermaid-diagram font-mono" data-mermaid-code={code}>
        {code}
      </div>
    </div>
  </div>
</div>

<style>
  /* Global body lock and z-index elevation when modal is active */
  :global(body.mermaid-modal-open) {
    overflow: hidden !important;
  }

  :global(body.mermaid-modal-open .site-header) {
    z-index: 10 !important;
  }

  :global(body.mermaid-modal-open .blog-layout-container),
  :global(body.mermaid-modal-open .site-main),
  :global(body.mermaid-modal-open .page-container) {
    z-index: 99990 !important;
  }

  .mermaid-wrapper {
    position: relative;
    margin: var(--space-6) 0;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-neu-sm);
    overflow: hidden;
    transition: all var(--transition-smooth);
  }

  /* Fullscreen Modal View */
  .mermaid-wrapper.is-fullscreen {
    position: fixed;
    top: 20px;
    left: 20px;
    right: 20px;
    bottom: 20px;
    z-index: 100000;
    margin: 0;
    border-radius: var(--radius-lg);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.7), 0 0 0 100vw rgba(0, 0, 0, 0.75);
    background-color: var(--color-surface);
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
  }

  @media (max-width: 640px) {
    .mermaid-wrapper.is-fullscreen {
      top: max(8px, env(safe-area-inset-top, 8px));
      left: max(8px, env(safe-area-inset-left, 8px));
      right: max(8px, env(safe-area-inset-right, 8px));
      bottom: max(8px, env(safe-area-inset-bottom, 8px));
      border-radius: var(--radius-md);
    }
  }

  .mermaid-wrapper.is-fullscreen .icon-expand {
    display: none !important;
  }

  .mermaid-wrapper.is-fullscreen .icon-collapse {
    display: block !important;
  }

  .mermaid-wrapper.is-fullscreen .close-modal-btn {
    display: inline-flex !important;
  }

  .mermaid-wrapper.is-fullscreen .modal-title {
    display: block !important;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* Toolbar Styling */
  .mermaid-toolbar {
    position: absolute;
    top: 10px;
    right: 10px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 8px;
    background-color: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-neu-sm);
    z-index: 20;
    opacity: 0.95;
    transition: opacity var(--transition-fast);
  }

  .mermaid-wrapper.is-fullscreen .mermaid-toolbar {
    position: relative;
    top: auto;
    right: auto;
    width: 100%;
    justify-content: space-between;
    padding: 10px 14px;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    border-top: none;
    border-left: none;
    border-right: none;
    border-bottom: 1px solid var(--color-border);
    opacity: 1;
    background-color: var(--color-surface-raised);
  }

  @media (max-width: 640px) {
    .mermaid-wrapper.is-fullscreen .mermaid-toolbar {
      padding: 8px 10px;
    }
  }

  .zoom-controls-group {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .mermaid-wrapper:hover .mermaid-toolbar,
  .mermaid-wrapper:focus-within .mermaid-toolbar {
    opacity: 1;
  }

  .tool-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    min-width: 28px;
    height: 28px;
    padding: 0 6px;
    border-radius: var(--radius-xs);
    background: transparent;
    border: 1px solid transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    font-size: var(--text-xs);
    transition: all var(--transition-fast);
    touch-action: manipulation;
  }

  @media (max-width: 640px) {
    .tool-btn {
      min-width: 34px;
      height: 34px;
      padding: 0 8px;
    }
  }

  .tool-btn:hover,
  .tool-btn:active {
    background-color: var(--color-surface-hover);
    color: var(--color-accent);
    border-color: var(--color-border);
  }

  .close-modal-btn {
    background-color: var(--color-accent-subtle);
    color: var(--color-accent);
    border-color: var(--color-accent);
    font-weight: 600;
  }

  .close-modal-btn:hover,
  .close-modal-btn:active {
    background-color: var(--color-accent);
    color: var(--color-accent-contrast);
  }

  .close-label {
    font-size: 0.6875rem;
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .close-label {
      display: inline-block;
      font-size: 0.75rem;
    }
  }

  .zoom-level-badge {
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--color-text-subtle);
    padding: 0 4px;
    min-width: 38px;
    text-align: center;
  }

  /* Viewport and Scalable Canvas */
  .mermaid-viewport {
    width: 100%;
    overflow: auto;
    -webkit-overflow-scrolling: touch;
    padding: var(--space-7) var(--space-4) var(--space-5);
    display: flex;
    justify-content: center;
    min-height: 180px;
    cursor: grab;
    user-select: none;
  }

  .mermaid-wrapper.is-fullscreen .mermaid-viewport {
    flex: 1;
    height: calc(100% - 50px);
    align-items: center;
    padding: var(--space-8);
  }

  .mermaid-canvas {
    width: 100%;
    transform-origin: center center;
    transition: transform 0.15s ease-out;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .mermaid-diagram {
    width: 100%;
    text-align: center;
    font-size: var(--text-sm);
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .mermaid-diagram :global(svg) {
    width: auto !important;
    max-width: 75% !important;
    max-height: 520px;
    height: auto !important;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .mermaid-diagram :global(svg) {
      max-width: 95% !important;
    }
  }

  .mermaid-wrapper.is-fullscreen .mermaid-diagram :global(svg) {
    max-width: 90% !important;
    max-height: 80vh !important;
  }
</style>

<script>
  async function initMermaidViewer() {
    const wrappers = document.querySelectorAll('.mermaid-wrapper');
    if (wrappers.length === 0) return;

    // 1. Render Mermaid SVGs
    try {
      const mermaid = (await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs')).default;
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';

      mermaid.initialize({
        startOnLoad: false,
        theme: isDark ? 'dark' : 'neutral',
        flowchart: {
          useMaxWidth: true,
          htmlLabels: true,
          curve: 'basis',
        },
        themeVariables: {
          fontFamily: 'JetBrains Mono, monospace',
          fontSize: '13px',
          primaryColor: isDark ? '#1c1f26' : '#f6f5f1',
          primaryTextColor: isDark ? '#f0eff4' : '#15171c',
          primaryBorderColor: isDark ? '#58a6ff' : '#1e4bd8',
          lineColor: isDark ? '#8b949e' : '#57606a',
        },
        securityLevel: 'strict',
      });

      for (let i = 0; i < wrappers.length; i++) {
        const wrapper = wrappers[i] as HTMLElement;
        const diagram = wrapper.querySelector('.mermaid-diagram:not([data-processed="true"])') as HTMLElement;
        if (!diagram) continue;

        const code = diagram.getAttribute('data-mermaid-code') || diagram.innerText;
        const id = `mermaid-svg-${Date.now()}-${i}`;
        try {
          const { svg } = await mermaid.render(id, code.trim());
          diagram.innerHTML = svg;
          const renderedSvg = diagram.querySelector('svg');
          if (renderedSvg) {
            renderedSvg.style.maxWidth = '75%';
            renderedSvg.style.height = 'auto';
          }
          diagram.setAttribute('data-processed', 'true');
        } catch (diagError) {
          console.warn(`Mermaid render failed on diagram ${i}:`, diagError);
          diagram.innerHTML = `<pre class="mermaid-error" style="color: var(--color-accent); font-size: 11px; padding: 8px; text-align: left; overflow: auto;">${code.trim()}</pre>`;
          diagram.setAttribute('data-processed', 'true');
        }
      }
    } catch (e) {
      console.warn('Failed to load Mermaid library:', e);
    }

    // 2. Attach Interactive Zoom & Fullscreen Modal Controls
    wrappers.forEach((wrapper) => {
      if (wrapper.getAttribute('data-controls-bound') === 'true') return;
      wrapper.setAttribute('data-controls-bound', 'true');

      let currentScale = 1.0;
      const canvas = wrapper.querySelector('.mermaid-canvas') as HTMLElement;
      const badge = wrapper.querySelector('.zoom-level-badge') as HTMLElement;
      const btnIn = wrapper.querySelector('.zoom-in-btn');
      const btnOut = wrapper.querySelector('.zoom-out-btn');
      const btnReset = wrapper.querySelector('.zoom-reset-btn');
      const btnFs = wrapper.querySelector('.fullscreen-btn');
      const btnClose = wrapper.querySelector('.close-modal-btn');

      const updateTransform = () => {
        if (canvas) {
          canvas.style.transform = `scale(${currentScale})`;
        }
        if (badge) {
          badge.textContent = `${Math.round(currentScale * 100)}%`;
        }
      };

      const setFullscreen = (open: boolean) => {
        wrapper.classList.toggle('is-fullscreen', open);
        if (open) {
          document.body.classList.add('mermaid-modal-open');
        } else {
          document.body.classList.remove('mermaid-modal-open');
          currentScale = 1.0;
          updateTransform();
        }
      };

      btnIn?.addEventListener('click', (e) => {
        e.stopPropagation();
        currentScale = Math.min(3.0, currentScale + 0.25);
        updateTransform();
      });

      btnOut?.addEventListener('click', (e) => {
        e.stopPropagation();
        currentScale = Math.max(0.5, currentScale - 0.25);
        updateTransform();
      });

      btnReset?.addEventListener('click', (e) => {
        e.stopPropagation();
        currentScale = 1.0;
        updateTransform();
      });

      btnFs?.addEventListener('click', (e) => {
        e.stopPropagation();
        const willOpen = !wrapper.classList.contains('is-fullscreen');
        setFullscreen(willOpen);
      });

      btnClose?.addEventListener('click', (e) => {
        e.stopPropagation();
        setFullscreen(false);
      });

      // Close modal on Escape key
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && wrapper.classList.contains('is-fullscreen')) {
          setFullscreen(false);
        }
      });
    });
  }

  initMermaidViewer();
  document.addEventListener('astro:page-load', initMermaidViewer);
  document.addEventListener('astro:after-swap', initMermaidViewer);
</script>
