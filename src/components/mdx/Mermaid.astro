---
interface Props {
  code: string;
}

const { code } = Astro.props;
---

<div class="mermaid-wrapper" data-zoom="1">
  <!-- Interactive Zoom & Fullscreen Toolbar -->
  <div class="mermaid-toolbar font-mono" aria-label="Diagram Zoom Controls">
    <button type="button" class="tool-btn zoom-out-btn" title="Zoom Out" aria-label="Zoom Out">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        <line x1="8" y1="11" x2="14" y2="11"></line>
      </svg>
    </button>

    <span class="zoom-level-badge" title="Current Zoom">100%</span>

    <button type="button" class="tool-btn zoom-in-btn" title="Zoom In" aria-label="Zoom In">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        <line x1="11" y1="8" x2="11" y2="14"></line>
        <line x1="8" y1="11" x2="14" y2="11"></line>
      </svg>
    </button>

    <button type="button" class="tool-btn zoom-reset-btn" title="Reset Zoom (100%)" aria-label="Reset Zoom">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
        <path d="M3 3v5h5"></path>
      </svg>
    </button>

    <button type="button" class="tool-btn fullscreen-btn" title="Expand Fullscreen" aria-label="Toggle Fullscreen">
      <svg class="icon-expand" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
      </svg>
      <svg class="icon-collapse" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
        <path d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3"></path>
      </svg>
    </button>
  </div>

  <!-- Diagram Canvas Area -->
  <div class="mermaid-viewport">
    <div class="mermaid-canvas">
      <div class="mermaid-diagram font-mono" data-mermaid-code={code}>
        {code}
      </div>
    </div>
  </div>
</div>

<style>
  .mermaid-wrapper {
    position: relative;
    margin: var(--space-6) 0;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-neu-sm);
    overflow: hidden;
    transition: all var(--transition-smooth);
  }

  /* Fullscreen Modal View */
  .mermaid-wrapper.is-fullscreen {
    position: fixed;
    inset: 20px;
    z-index: 9999;
    margin: 0;
    border-radius: var(--radius-lg);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6), 0 0 0 100vw rgba(0, 0, 0, 0.75);
    background-color: var(--color-surface);
    display: flex;
    flex-direction: column;
  }

  .mermaid-wrapper.is-fullscreen .icon-expand {
    display: none !important;
  }

  .mermaid-wrapper.is-fullscreen .icon-collapse {
    display: block !important;
  }

  /* Floating Toolbar */
  .mermaid-toolbar {
    position: absolute;
    top: 10px;
    right: 10px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 6px;
    background-color: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-neu-sm);
    z-index: 10;
    opacity: 0.85;
    transition: opacity var(--transition-fast);
  }

  .mermaid-wrapper:hover .mermaid-toolbar,
  .mermaid-wrapper:focus-within .mermaid-toolbar {
    opacity: 1;
  }

  .tool-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    padding: 0;
    border-radius: var(--radius-xs);
    background: transparent;
    border: 1px solid transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .tool-btn:hover {
    background-color: var(--color-surface-hover);
    color: var(--color-accent);
    border-color: var(--color-border);
  }

  .zoom-level-badge {
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--color-text-subtle);
    padding: 0 4px;
    min-width: 38px;
    text-align: center;
  }

  /* Viewport and Scalable Canvas */
  .mermaid-viewport {
    width: 100%;
    overflow: auto;
    padding: var(--space-7) var(--space-4) var(--space-5);
    display: flex;
    justify-content: center;
    min-height: 180px;
    cursor: grab;
    user-select: none;
  }

  .mermaid-wrapper.is-fullscreen .mermaid-viewport {
    flex: 1;
    height: 100%;
    align-items: center;
    padding: var(--space-8);
  }

  .mermaid-canvas {
    transform-origin: center center;
    transition: transform 0.15s ease-out;
    display: inline-flex;
    justify-content: center;
  }

  .mermaid-diagram {
    text-align: center;
    font-size: var(--text-sm);
  }

  .mermaid-diagram :global(svg) {
    max-width: 100% !important;
    height: auto !important;
  }

  .mermaid-wrapper.is-fullscreen .mermaid-diagram :global(svg) {
    max-width: none !important;
  }
</style>

<script>
  async function initMermaidViewer() {
    const wrappers = document.querySelectorAll('.mermaid-wrapper');
    if (wrappers.length === 0) return;

    // 1. Render Mermaid SVGs
    try {
      const mermaid = (await import('https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs')).default;
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';

      mermaid.initialize({
        startOnLoad: false,
        theme: isDark ? 'dark' : 'neutral',
        themeVariables: {
          fontFamily: 'JetBrains Mono, monospace',
          fontSize: '13px',
          primaryColor: isDark ? '#1c1f26' : '#f6f5f1',
          primaryTextColor: isDark ? '#f0eff4' : '#15171c',
          primaryBorderColor: isDark ? '#58a6ff' : '#1e4bd8',
          lineColor: isDark ? '#8b949e' : '#57606a',
        },
        securityLevel: 'strict',
      });

      for (let i = 0; i < wrappers.length; i++) {
        const wrapper = wrappers[i] as HTMLElement;
        const diagram = wrapper.querySelector('.mermaid-diagram:not([data-processed="true"])') as HTMLElement;
        if (!diagram) continue;

        const code = diagram.getAttribute('data-mermaid-code') || diagram.innerText;
        const id = `mermaid-svg-${Date.now()}-${i}`;
        try {
          const { svg } = await mermaid.render(id, code.trim());
          diagram.innerHTML = svg;
          diagram.setAttribute('data-processed', 'true');
        } catch (diagError) {
          console.warn(`Mermaid render failed on diagram ${i}:`, diagError);
          diagram.innerHTML = `<pre class="mermaid-error" style="color: var(--color-accent); font-size: 11px; padding: 8px; text-align: left; overflow: auto;">${code.trim()}</pre>`;
          diagram.setAttribute('data-processed', 'true');
        }
      }
    } catch (e) {
      console.warn('Failed to load Mermaid library:', e);
    }

    // 2. Attach Interactive Zoom Controls
    wrappers.forEach((wrapper) => {
      if (wrapper.getAttribute('data-controls-bound') === 'true') return;
      wrapper.setAttribute('data-controls-bound', 'true');

      let currentScale = 1.0;
      const canvas = wrapper.querySelector('.mermaid-canvas') as HTMLElement;
      const badge = wrapper.querySelector('.zoom-level-badge') as HTMLElement;
      const btnIn = wrapper.querySelector('.zoom-in-btn');
      const btnOut = wrapper.querySelector('.zoom-out-btn');
      const btnReset = wrapper.querySelector('.zoom-reset-btn');
      const btnFs = wrapper.querySelector('.fullscreen-btn');

      const updateTransform = () => {
        if (canvas) {
          canvas.style.transform = `scale(${currentScale})`;
        }
        if (badge) {
          badge.textContent = `${Math.round(currentScale * 100)}%`;
        }
      };

      btnIn?.addEventListener('click', () => {
        currentScale = Math.min(3.0, currentScale + 0.25);
        updateTransform();
      });

      btnOut?.addEventListener('click', () => {
        currentScale = Math.max(0.5, currentScale - 0.25);
        updateTransform();
      });

      btnReset?.addEventListener('click', () => {
        currentScale = 1.0;
        updateTransform();
      });

      btnFs?.addEventListener('click', () => {
        wrapper.classList.toggle('is-fullscreen');
        if (!wrapper.classList.contains('is-fullscreen')) {
          currentScale = 1.0;
          updateTransform();
        }
      });

      // Close fullscreen on Escape key
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && wrapper.classList.contains('is-fullscreen')) {
          wrapper.classList.remove('is-fullscreen');
          currentScale = 1.0;
          updateTransform();
        }
      });
    });
  }

  initMermaidViewer();
  document.addEventListener('astro:page-load', initMermaidViewer);
  document.addEventListener('astro:after-swap', initMermaidViewer);
</script>
