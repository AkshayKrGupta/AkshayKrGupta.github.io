---
interface ImageItem {
  src: string;
  alt: string;
  caption?: string;
}

interface Props {
  images: ImageItem[];
  columns?: 2 | 3;
}

const { images, columns = 2 } = Astro.props;
---

<div class={`gallery-container columns-${columns}`}>
  {images.map((img) => (
    <figure class="gallery-item">
      <img src={img.src} alt={img.alt} loading="lazy" class="gallery-img" />
      {img.caption && (
        <figcaption class="gallery-caption font-mono">{img.caption}</figcaption>
      )}
    </figure>
  ))}
</div>

<style>
  .gallery-container {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-6) 0;
  }

  .columns-2 {
    grid-template-columns: 1fr;
  }

  .columns-3 {
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .columns-2 {
      grid-template-columns: repeat(2, 1fr);
    }
    .columns-3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .gallery-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0;
  }

  .gallery-img {
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-neu-sm);
  }

  .gallery-caption {
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    text-align: center;
  }
</style>
